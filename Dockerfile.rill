# Rill Dashboard Dockerfile
# https://docs.rill.dev/deploy/docker

FROM --platform=linux/amd64 rilldata/rill:latest

LABEL maintainer="gaming-analytics-pipeline"
LABEL version="1.0.0"
LABEL description="Rill real-time dashboard for gaming analytics"

WORKDIR /app

# Copy Rill project files
COPY rill/ ./rill/

# Create data directory for DuckDB volume mount
RUN mkdir -p /app/data

# Expose Rill's default port
EXPOSE 9009

# Override the default entrypoint and start Rill with proper arguments
ENTRYPOINT ["/usr/local/bin/rill"]
CMD ["start", "./rill", "--port", "9009"]
