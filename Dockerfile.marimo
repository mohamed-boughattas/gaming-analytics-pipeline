# Marimo Dashboard Dockerfile
FROM python:3.12-slim

LABEL maintainer="gaming-analytics-pipeline"
LABEL version="1.0.0"
LABEL description="Marimo marimo for gaming analytics pipeline"

WORKDIR /app

RUN apt-get update && apt-get install -y gcc curl && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies with uv
RUN uv pip install --system --no-cache-dir marimo plotly duckdb pandas pydantic pydantic-settings

COPY marimo/ ./marimo/
COPY src/ ./src/

RUN mkdir -p /app/data

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 2718

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:2718/ || exit 1

# --no-token disables authentication for demo/portfolio purposes only
# For production, remove this flag and set MARIMO_TOKEN environment variable
CMD ["marimo", "edit", "marimo/gaming_analytics.py", "--headless", "--host", "0.0.0.0", "--port", "2718", "--no-token"]
